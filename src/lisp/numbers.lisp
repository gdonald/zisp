;;; Integers as bits, byte specifiers, and the numeric functions built on
;;; the arithmetic natives.

(in-package "COMMON-LISP")

(defconstant boole-clr 0)
(defconstant boole-set 1)
(defconstant boole-1 2)
(defconstant boole-2 3)
(defconstant boole-c1 4)
(defconstant boole-c2 5)
(defconstant boole-and 6)
(defconstant boole-ior 7)
(defconstant boole-xor 8)
(defconstant boole-eqv 9)
(defconstant boole-nand 10)
(defconstant boole-nor 11)
(defconstant boole-andc1 12)
(defconstant boole-andc2 13)
(defconstant boole-orc1 14)
(defconstant boole-orc2 15)

(defun logeqv (&rest integers)
  (let ((result -1))
    (dolist (integer integers result)
      (setq result (lognot (logxor result integer))))))

(defun lognand (integer-1 integer-2) (lognot (logand integer-1 integer-2)))
(defun lognor (integer-1 integer-2) (lognot (logior integer-1 integer-2)))
(defun logandc1 (integer-1 integer-2) (logand (lognot integer-1) integer-2))
(defun logandc2 (integer-1 integer-2) (logand integer-1 (lognot integer-2)))
(defun logorc1 (integer-1 integer-2) (logior (lognot integer-1) integer-2))
(defun logorc2 (integer-1 integer-2) (logior integer-1 (lognot integer-2)))

(defun boole (op integer-1 integer-2)
  (check-type integer-1 integer)
  (check-type integer-2 integer)
  (case op
    (#.boole-clr 0)
    (#.boole-set -1)
    (#.boole-1 integer-1)
    (#.boole-2 integer-2)
    (#.boole-c1 (lognot integer-1))
    (#.boole-c2 (lognot integer-2))
    (#.boole-and (logand integer-1 integer-2))
    (#.boole-ior (logior integer-1 integer-2))
    (#.boole-xor (logxor integer-1 integer-2))
    (#.boole-eqv (logeqv integer-1 integer-2))
    (#.boole-nand (lognand integer-1 integer-2))
    (#.boole-nor (lognor integer-1 integer-2))
    (#.boole-andc1 (logandc1 integer-1 integer-2))
    (#.boole-andc2 (logandc2 integer-1 integer-2))
    (#.boole-orc1 (logorc1 integer-1 integer-2))
    (#.boole-orc2 (logorc2 integer-1 integer-2))
    (t (error 'type-error :datum op :expected-type '(integer 0 15)))))

(defun logtest (integer-1 integer-2)
  (not (zerop (logand integer-1 integer-2))))

(defun logbitp (index integer)
  (check-type index (integer 0 *))
  (check-type integer integer)
  (oddp (ash integer (- index))))

(defun logcount (integer)
  (check-type integer integer)
  (let ((bits (if (minusp integer) (lognot integer) integer))
        (count 0))
    (loop until (zerop bits)
          do (when (oddp bits) (incf count))
             (setq bits (ash bits -1)))
    count))

;; A byte specifier is a cons of its size and position.
(defun byte (size position)
  (check-type size (integer 0 *))
  (check-type position (integer 0 *))
  (cons size position))

(defun byte-size (bytespec) (car bytespec))
(defun byte-position (bytespec) (cdr bytespec))

(defun %byte-mask (bytespec)
  (ash (1- (ash 1 (byte-size bytespec))) (byte-position bytespec)))

(defun ldb (bytespec integer)
  (check-type integer integer)
  (logand (ash integer (- (byte-position bytespec)))
          (1- (ash 1 (byte-size bytespec)))))

(defun ldb-test (bytespec integer)
  (not (zerop (ldb bytespec integer))))

(defun mask-field (bytespec integer)
  (check-type integer integer)
  (logand integer (%byte-mask bytespec)))

(defun dpb (newbyte bytespec integer)
  (check-type newbyte integer)
  (check-type integer integer)
  (let ((mask (%byte-mask bytespec)))
    (logior (logandc2 integer mask)
            (logand (ash newbyte (byte-position bytespec)) mask))))

(defun deposit-field (newbyte bytespec integer)
  (check-type newbyte integer)
  (check-type integer integer)
  (let ((mask (%byte-mask bytespec)))
    (logior (logandc2 integer mask) (logand newbyte mask))))

(define-setf-expander ldb (bytespec integer &environment environment)
  (multiple-value-bind (temps values stores store-form access-form)
      (get-setf-expansion integer environment)
    (let ((byte (gensym "BYTE"))
          (new (gensym "NEW")))
      (values (cons byte temps)
              (cons bytespec values)
              (list new)
              `(let ((,(car stores) (dpb ,new ,byte ,access-form)))
                 ,store-form
                 ,new)
              `(ldb ,byte ,access-form)))))

(define-setf-expander mask-field (bytespec integer &environment environment)
  (multiple-value-bind (temps values stores store-form access-form)
      (get-setf-expansion integer environment)
    (let ((byte (gensym "BYTE"))
          (new (gensym "NEW")))
      (values (cons byte temps)
              (cons bytespec values)
              (list new)
              `(let ((,(car stores) (deposit-field ,new ,byte ,access-form)))
                 ,store-form
                 ,new)
              `(mask-field ,byte ,access-form)))))

(defun signum (number)
  (check-type number number)
  (cond ((zerop number) number)
        ((complexp number) (/ number (abs number)))
        ((rationalp number) (if (plusp number) 1 -1))
        (t (float-sign number (float 1 number)))))

(defun cis (radians)
  (check-type radians real)
  (complex (cos radians) (sin radians)))

;; The simplest rational in the closed interval [low, high], 0 < low < high:
;; the one with the smallest denominator, from its continued fraction.
(defun %simplest-rational (low high)
  (let ((whole (floor low)))
    (cond ((= whole low) whole)
          ((< whole (floor high)) (1+ whole))
          (t (+ whole (/ (%simplest-rational (/ (- high whole)) (/ (- low whole)))))))))

(defun rationalize (number)
  (check-type number real)
  (if (rationalp number)
      number
      (multiple-value-bind (significand exponent sign) (integer-decode-float number)
        (cond ((zerop significand) 0)
              ((>= exponent 0) (* sign (ash significand exponent)))
              (t (let ((scale (ash 1 (- 1 exponent))))
                   (* sign (%simplest-rational (/ (1- (* 2 significand)) scale)
                                               (/ (1+ (* 2 significand)) scale)))))))))

(defun %float-quotient (quotient number divisor)
  (float quotient (cond ((and (floatp number) (floatp divisor)) (* 0 number divisor))
                        ((floatp number) number)
                        ((floatp divisor) divisor)
                        (t 1.0))))

(macrolet ((define-float-division (name integer-division)
             `(defun ,name (number &optional (divisor 1))
                (multiple-value-bind (quotient remainder) (,integer-division number divisor)
                  (values (%float-quotient quotient number divisor) remainder)))))
  (define-float-division ffloor floor)
  (define-float-division fceiling ceiling)
  (define-float-division ftruncate truncate)
  (define-float-division fround round))

(in-package "COMMON-LISP-USER")
