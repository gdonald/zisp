;; Every form here must evaluate to T.

(equal (let ((seen nil)) (dolist (x '(1 2 3)) (push x seen)) seen) '(3 2 1))
(null (dolist (x '(1 2))))
(eql (dolist (x '(1 2) :done) x) :done)
(let ((last :unset))
  (dolist (x '(1 2) (setq last x)))
  (null last))
(eql (dolist (x '(1 2 3)) (when (= x 2) (return x))) 2)
(equal (let ((seen nil)) (dotimes (i 3) (push i seen)) seen) '(2 1 0))
(eql (dotimes (i 3 :done)) :done)
(eql (dotimes (i 5) (when (= i 2) (return i))) 2)
(null (dotimes (i 0)))
(equal (do ((i 0 (1+ i)) (acc nil (cons i acc))) ((= i 3) acc)) '(2 1 0))
(eql (do* ((i 0 (1+ i)) (j i (1+ i))) ((= i 2) j)) 3)
(eql (do ((i 0 (1+ i))) (nil) (when (= i 4) (return i))) 4)
(equal (let ((a 1) (b 2)) (psetq a b b a) (list a b)) '(2 1))
(equal (let ((a 1) (b 2)) (setq a b b a) (list a b)) '(2 2))
(eql (do ((i 0 (1+ i)) (total 0 (+ total i))) ((= i 4) total)) 6)
(let ((steps 0))
  (do ((i 0 (1+ i))) ((= i 3)) (declare (ignore i)) (setq steps (1+ steps)))
  (eql steps 3))

;; dohash runs its body once for each entry, binding the key and value,
;; inside a block named nil, and returns its result form.
(let ((table (make-hash-table)) (sum 0))
  (setf (gethash 1 table) 10 (gethash 2 table) 20)
  (and (eql (dohash (key value table sum) (incf sum (+ key value))) 33)
       (eql sum 33)))
(let ((table (make-hash-table)))
  (setf (gethash :a table) 1)
  (eq (dohash (key value table :finished) (return :early)) :early))
(null (dohash (key value (make-hash-table))))

;; Declarations at the head of a do, dolist or dotimes body cover its
;; variables and its result form.
(let ((x :outer))
  (declare (special x))
  (let ((x :inner))
    (declare (ignorable x))
    (eq (dotimes (i 1 x) (declare (special x))) :outer)))
(let ((seen nil))
  (flet ((peek () (locally (declare (special e)) e)))
    (dolist (e '(a b) (equal (reverse seen) '(a b)))
      (declare (special e))
      (push (peek) seen))))
