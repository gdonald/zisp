(defun golden-sample (items limit)
  (declare (optimize (debug 3)))
  (let ((total 0)
        (kept '()))
    (when (> limit 0)
      (setq kept (remove-if-not #'numberp items)))
    (setq total (reduce #'+ kept))
    (if (> total limit)
        (format nil "~a over" total)
        (list :total total :kept (length kept)))))
